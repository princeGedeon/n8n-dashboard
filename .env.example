# Copier en .env et remplir. Ne jamais committer le fichier .env.

# Adresse de n8n (sans / final)
N8N_URL=https://n8n.srv1004594.hstgr.cloud

# Clé partagée app ↔ n8n : même valeur que l'identifiant n8n « Formulaires — clé serveur (X-Forms-Key) »
N8N_FORMS_KEY=

# Secret de signature des sessions admin (32+ caractères aléatoires)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Captcha Cloudflare Turnstile du formulaire client (facultatif : laisser vide pour le désactiver)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

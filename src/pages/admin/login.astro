---
import Base from '../../layouts/Base.astro';
import { isValidSession } from '../../lib/session';
if (isValidSession(Astro.cookies)) return Astro.redirect('/admin');
const e = Astro.url.searchParams.get('e');
const message = e === '1' ? 'Mot de passe incorrect.' : e === '2' ? 'Trop de tentatives, réessayez dans 15 minutes.' : e === '3' ? 'Service indisponible (n8n), réessayez.' : '';
---
<Base title="Connexion — Admin" noindex>
  <main class="flex min-h-screen items-center justify-center p-4">
    <form method="post" action="/api/admin/login" class="card w-full max-w-sm space-y-4">
      <div>
        <h1 class="text-lg font-semibold text-slate-900">Espace admin</h1>
        <p class="text-sm text-slate-500">Lapland — réservations</p>
      </div>
      {message && <p class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{message}</p>}
      <div>
        <label class="label" for="password">Mot de passe</label>
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required autofocus />
      </div>
      <button class="btn w-full" type="submit">Se connecter</button>
    </form>
  </main>
</Base>

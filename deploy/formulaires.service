# Service systemd : lance l'app au démarrage du serveur et la relance si elle s'arrête.
# Installation : voir README.md, section « Déployer sans Docker ».
[Unit]
Description=Formulaires Lapland (Astro)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=formulaires
Group=formulaires
WorkingDirectory=/opt/lapland/formulaires
EnvironmentFile=/opt/lapland/formulaires/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=5

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lapland/formulaires

[Install]
WantedBy=multi-user.target
